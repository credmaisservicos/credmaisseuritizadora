ecuritizadora/assets/img/servicos/antecipacao-hero-wide.webp.webp\" sizes=\"(max-width: 1024px) 100vw, 440px\" alt=\"\" loading=\"eager\">\n    </a>\n    <a href=\"/servicos/boleto-garantido/\" class=\"mega__preview\" data-i=\"2\" tabindex=\"-1\" aria-hidden=\"true\" title=\"Conhecer Boleto Garantido\">\n      <img class=\"mega__preview-image\" src=\"/admin/preview/assets/securitizadora/assets/img/servicos/boleto-garantido-historia.webp.webp\" sizes=\"(max-width: 1024px) 100vw, 440px\" alt=\"\" loading=\"eager\">\n    </a>\n    <a href=\"/servicos/gestao-de-cobrancas/\" class=\"mega__preview\" data-i=\"3\" tabindex=\"-1\" aria-hidden=\"true\" title=\"Conhecer Gestão de cobranças\">\n      <img class=\"mega__preview-image\" src=\"/admin/preview/assets/securitizadora/assets/img/servicos/gestao-de-cobrancas-historia.webp.webp\" sizes=\"(max-width: 1024px) 100vw, 440px\" alt=\"\" loading=\"eager\">\n    </a></div>\n              </div>\n            </div>\n          </div>\n\n          <a href=\"/#como-funciona\" data-section=\"como-funciona\">Como funciona</a>\n          <a href=\"/contato/\" data-section=\"contato\">Contato</a>\n        </nav>\n\n        <div class=\"nav__actions\">\n          <a href=\"/contato/\" class=\"btn-navy\"><span>Fale conosco</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"></path></svg></a>\n          <button class=\"burger\" type=\"button\" aria-label=\"Abrir menu\" aria-expanded=\"false\" aria-controls=\"menu\">\n            <span></span><span></span>\n          </button>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  <div class=\"menu\" id=\"menu\" aria-hidden=\"true\">\n    <div class=\"menu__panel\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Menu\">\n      <nav class=\"menu__links\">\n        <a href=\"/#inicio\" data-section=\"inicio\"><small>01</small><span>Início</span></a>\n\n        <div class=\"menu__group is-open\">\n          <button class=\"menu__toggle\" type=\"button\" aria-expanded=\"true\" aria-controls=\"menu-servicos\">\n            <small>02</small><span>Serviços</span><i aria-hidden=\"true\"></i>\n          </button>\n          <div class=\"menu__sub\" id=\"menu-servicos\">\n            <div class=\"menu__sub-inner\">\n    <a href=\"/servicos/pix-parcelado/\">Pix Parcelado</a>\n    <a href=\"/servicos/antecipacao-de-recebiveis/\" class=\"is-active\" aria-current=\"page\">Antecipação de boletos e recebíveis</a>\n    <a href=\"/servicos/boleto-garantido/\">Boleto Garantido</a>\n    <a href=\"/servicos/gestao-de-cobrancas/\">Gestão de cobranças</a></div>\n          </div>\n        </div>\n\n        <a href=\"/#como-funciona\" data-section=\"como-funciona\"><small>03</small><span>Como funciona</span></a>\n        <a href=\"/contato/\" data-section=\"contato\"><small>04</small><span>Contato</span></a>\n      </nav>\n\n      <div class=\"menu__footer\">\n        <a href=\"/contato/\" class=\"btn-navy btn-navy--full\"><span>Fale conosco</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"></path></svg></a>\n        <div class=\"menu__contact\">\n          <a href=\"https://wa.me/5511940893852\" target=\"_blank\" rel=\"noopener\"><small>WhatsApp</small>(11) 94089-3852</a>\n          <a href=\"mailto:contato@sejacredmais.com\"><small>E-mail</small>contato@sejacredmais.com</a>\n        </div>\n      </div>\n    </div>\n  </div>\n  \n\n  <main>\n    <section class=\"ar-hero\" id=\"inicio\" aria-labelledby=\"ar-title\" data-cm-hero=\"true\">\n      <div class=\"ar-hero__copy\">\n        <p class=\"ar-label ar-hero__motion\" style=\"--d: .2s;\">Mais fluxo para o seu crescimento</p>\n        <h1 id=\"ar-title\" data-cm-hero-title=\"true\"><span class=\"ar-hero__line ar-hero__motion\" style=\"--d: .3s;\">Antecipe seus</span><span class=\"ar-hero__line ar-hero__line--gold ar-hero__motion\" style=\"--d: .4s;\">Recebíveis</span></h1>\n        <p class=\"ar-hero__description ar-hero__motion\" style=\"--d: .55s;\" data-cm-hero-text=\"true\">Avalie com a CredMais se os valores que sua empresa tem a receber podem ajudar a organizar o caixa agora.</p>\n        <a class=\"ar-button ar-button--white ar-hero__motion\" style=\"--d: .68s;\" href=\"https://wa.me/5511940893852?text=Ol%C3%A1%2C%20quero%20conversar%20sobre%20antecipa%C3%A7%C3%A3o%20de%20receb%C3%ADveis.\" target=\"_blank\" rel=\"noopener noreferrer\" data-cm-hero-button=\"true\">\n          <span>Converse sobre seus recebíveis</span><span aria-hidden=\"true\">↗</span>\n        </a>\n      </div>\n      <div class=\"ar-hero__visual\">\n        <img src=\"/admin/preview/assets/securitizadora/assets/img/servicos/antecipacao-hero-wide.webp.webp\" sizes=\"100vw\" width=\"1672\" height=\"941\" alt=\"Empreendedor analisa os recebíveis da empresa em um tablet\" fetchpriority=\"high\" loading=\"eager\">\n      </div>\n    </section>\n\n    <section class=\"ar-timing\" aria-labelledby=\"ar-timing-title\" data-cm-section=\"original-0\">\n      <div class=\"ar-timing__inner\">\n        <div class=\"ar-timing__intro\" data-ar-reveal=\"\">\n          <p class=\"ar-label ar-label--gold\">O intervalo também conta</p>\n          <h2 id=\"ar-timing-title\" data-cm-title=\"true\">A venda acontece em um momento.<br><span>O recebimento, em outro.</span></h2>\n          <p data-cm-text=\"true\">Esse espaço entre vender e receber pode fazer diferença na rotina financeira da empresa. A antecipação permite avaliar uma alternativa com base nos valores que já estão previstos para entrar.</p>\n        </div>\n        <div class=\"ar-timing__line\" data-ar-reveal=\"\" style=\"--reveal-delay: .12s;\" aria-label=\"Uma venda gera um recebível previsto para depois\">\n          <div class=\"ar-timing__point\">\n            <span class=\"ar-timing__dot\" aria-hidden=\"true\"></span>\n            <strong>Venda realizada</strong>\n            <span>A empresa conclui a venda</span>\n          </div>\n          <div class=\"ar-timing__gap\"><span>antecipação em análise</span></div>\n          <div class=\"ar-timing__point\">\n            <span class=\"ar-timing__dot\" aria-hidden=\"true\"></span>\n            <strong>Recebimento previsto</strong>\n            <span>O valor tem previsão de entrada futura</span>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"ar-editorial\" aria-labelledby=\"ar-editorial-title\" data-cm-section=\"section-1\">\n      <div class=\"ar-editorial__photo\" data-ar-reveal=\"\">\n        <img src=\"/admin/preview/assets/securitizadora/assets/img/servicos/antecipacao-bastidores.webp.webp\" sizes=\"(max-width: 719px) calc(100vw - 48px), 52vw\" width=\"1536\" height=\"1024\" alt=\"Empreendedora consulta seu planejamento e documentos em um ateliê\" loading=\"eager\" data-cm-image=\"true\">\n      </div>\n      <div class=\"ar-editorial__copy\" data-ar-reveal=\"\" style=\"--reveal-delay: .1s;\">\n        <p class=\"ar-label\">O negócio segue em movimento</p>\n        <h2 id=\"ar-editorial-title\" data-cm-title=\"true\">Compras, prazos e planos não ficam esperando.</h2>\n        <p data-cm-text=\"true\">Enquanto alguns recebimentos ainda estão previstos para depois, sua empresa continua tomando decisões todos os dias.</p>\n        <p>A CredMais conversa com você, avalia os recebíveis apresentados e explica as condições de uma possível operação.</p>\n        <a class=\"ar-link\" href=\"https://wa.me/5511940893852?text=Ol%C3%A1%2C%20quero%20entender%20as%20possibilidades%20para%20os%20receb%C3%ADveis%20da%20minha%20empresa.\" target=\"_blank\" rel=\"noopener noreferrer\">Fale com a equipe CredMais <span aria-hidden=\"true\">→</span></a>\n      </div>\n    </section>\n\n    <section class=\"ar-analysis\" aria-labelledby=\"ar-analysis-title\" data-cm-section=\"section-2\">\n      <div class=\"ar-analysis__inner\">\n        <div class=\"ar-analysis__heading\" data-ar-reveal=\"\">\n          <p class=\"ar-label ar-label--light\">Cada operação é avaliada individualmente</p>\n          <h2 id=\"ar-analysis-title\" data-cm-title=\"true\">Uma proposta começa entendendo o seu cenário.</h2>\n        </div>\n        <div class=\"ar-analysis__steps\">\n          <article class=\"ar-analysis__step\" data-ar-reveal=\"\">\n            <span>01</span>\n            <div><h3>O que sua empresa tem a receber</h3><p>Apresente à equipe os valores que deseja avaliar.</p></div>\n          </article>\n          <article class=\"ar-analysis__step\" data-ar-reveal=\"\" style=\"--reveal-delay: .08s;\">\n            <span>02</span>\n            <div><h3>O momento do seu negócio</h3><p>Conte o que você precisa organizar no fluxo da empresa.</p></div>\n          </article>\n          <article class=\"ar-analysis__step\" data-ar-reveal=\"\" style=\"--reveal-delay: .16s;\">\n            <span>03</span>\n            <div><h3>As condições da operação</h3><p data-cm-text=\"true\">A CredMais analisa o caso e explica as possibilidades para sua avaliação.</p></div>\n          </article>\n        </div>\n        <p class=\"ar-analysis__note\" data-ar-reveal=\"\" style=\"--reveal-delay: .22s;\">A realização de qualquer operação depende de análise e das condições acordadas entre as partes.</p>\n      </div>\n    </section>\n\n    <section class=\"ar-conversation\" aria-labelledby=\"ar-conversation-title\" data-cm-section=\"section-3\">\n      <div class=\"ar-conversation__inner\">\n        <div class=\"ar-conversation__heading\" data-ar-reveal=\"\">\n          <p class=\"ar-label ar-label--gold\">Para começar a conversa</p>\n          <h2 id=\"ar-conversation-title\" data-cm-title=\"true\">Traga o que você já sabe.</h2>\n          <p data-cm-text=\"true\">Não precisa chegar com todas as respostas. Esses pontos ajudam a equipe a entender o contexto da sua empresa.</p>\n        </div>\n        <ol class=\"ar-conversation__list\" data-ar-reveal=\"\" style=\"--reveal-delay: .12s;\">\n          <li><span>01</span><p>Quais valores sua empresa tem a receber?</p></li>\n          <li><span>02</span><p>Quando esses recebimentos estão previstos?</p></li>\n          <li><span>03</span><p>O que você busca organizar no caixa agora?</p></li>\n        </ol>\n      </div>\n    </section>\n\n    <section class=\"ar-faq\" aria-labelledby=\"ar-faq-title\" data-cm-section=\"section-4\">\n      <div class=\"ar-faq__inner\">\n        <div class=\"ar-faq__intro\" data-ar-reveal=\"\">\n          <p class=\"ar-label\">Dúvidas comuns</p>\n          <h2 id=\"ar-faq-title\" data-cm-title=\"true\">Antes de falar com a CredMais</h2>\n        </div>\n        <div class=\"ar-faq__list\" data-ar-reveal=\"\" style=\"--reveal-delay: .12s;\">\n          <details>\n            <summary>Quais recebíveis podem ser avaliados?<span aria-hidden=\"true\"></span></summary>\n            <p data-cm-text=\"true\">Você pode apresentar à equipe os valores que sua empresa tem a receber. A possibilidade de operação depende da análise de cada caso.</p>\n          </details>\n          <details>\n            <summary>A antecipação é automática?<span aria-hidden=\"true\"></span></summary>\n            <p>Não. Cada operação passa por análise e as condições são apresentadas para você avaliar antes de qualquer contratação.</p>\n          </details>\n          <details>\n            <summary>Como descubro as condições para minha empresa?<span aria-hidden=\"true\"></span></summary>\n            <p>Converse com a CredMais, conte o contexto da empresa e apresente os recebíveis que deseja avaliar. A equipe explica os próximos passos.</p>\n          </details>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"ar-contact\" aria-labelledby=\"ar-contact-title\" data-cm-section=\"section-5\">\n      <div class=\"ar-contact__inner\" data-ar-reveal=\"\">\n        <p class=\"ar-label ar-label--light\">Antecipação de recebíveis CredMais</p>\n        <h2 id=\"ar-contact-title\" data-cm-title=\"true\">Vamos conversar sobre o momento da sua empresa?</h2>\n        <a class=\"ar-button ar-button--white\" href=\"https://wa.me/5511940893852?text=Ol%C3%A1%2C%20quero%20conversar%20sobre%20antecipa%C3%A7%C3%A3o%20de%20receb%C3%ADveis.\" target=\"_blank\" rel=\"noopener noreferrer\">\n          <span>Chame a CredMais no WhatsApp</span><span aria-hidden=\"true\">↗</span>\n        </a>\n      </div>\n      <span class=\"ar-contact__word\" aria-hidden=\"true\">Recebíveis</span>\n    </section>\n  </main>\n\n  <div id=\"site-footer\">\n    <footer class=\"site-footer\" aria-label=\"Rodapé CredMais\">\n      <div class=\"container site-footer__inner\">\n        <div class=\"site-footer__brand\">\n          <a class=\"site-footer__logo\" href=\"/#inicio\" aria-label=\"CredMais — voltar ao início\">\n            <img src=\"/admin/preview/assets/securitizadora/assets/img/logo-branco.png.webp\" width=\"430\" height=\"143\" alt=\"CredMais Securitizadora\" loading=\"eager\">\n          </a>\n          <p>Soluções para sua empresa vender, receber e seguir em frente.</p>\n        </div>\n        <nav class=\"site-footer__nav\" aria-label=\"Links do rodapé\">\n          <h2>Navegue</h2>\n          <a href=\"/#inicio\">Início</a>\n          <a href=\"/#servicos\">Serviços</a>\n          <a href=\"/#como-funciona\">Como funciona</a>\n          <a href=\"/contato/\">Contato</a>\n        </nav>\n        <div class=\"site-footer__contact\">\n          <h2>Fale com a CredMais</h2>\n          <a href=\"https://wa.me/5511940893852\" target=\"_blank\" rel=\"noopener noreferrer\">WhatsApp <span>(11) 94089-3852</span></a>\n          <a href=\"mailto:contato@sejacredmais.com\">E-mail <span>contato@sejacredmais.com</span></a>\n          <a href=\"https://www.instagram.com/credmais.sa/\" target=\"_blank\" rel=\"noopener noreferrer\">Instagram <span>@credmais.sa</span></a>\n        </div>\n      </div>\n      <div class=\"container site-footer__bottom\">\n        <span>CredMais Securitizadora</span>\n        <a href=\"https://focussdev.art\" target=\"_blank\" rel=\"noopener noreferrer\">Desenvolvido por FocusDev <span aria-hidden=\"true\">↗</span></a>\n      </div>\n    </footer></div>\n  \n  \n  \n\n\n","bodyClass":"","sections":[{"id":"original-0","type":"original","title":"A venda acontece em um momento.O recebimento, em outro.","text":"Esse espaço entre vender e receber pode fazer diferença na rotina financeira da empresa. A antecipação permite avaliar uma alternativa com base nos valores que já estão previstos para entrar.","visible":true,"sourceHTML":"<section class=\"ar-timing\" aria-labelledby=\"ar-timing-title\" data-cm-section=\"original-0\">\n      <div class=\"ar-timing__inner\">\n        <div class=\"ar-timing__intro\" data-ar-reveal=\"\">\n          <p class=\"ar-label ar-label--gold\">O intervalo também conta</p>\n          <h2 id=\"ar-timing-title\" data-cm-title=\"true\">A venda acontece em um momento.<br><span>O recebimento, em outro.</span></h2>\n          <p data-cm-text=\"true\">Esse espaço entre vender e receber pode fazer diferença na rotina financeira da empresa. A antecipação permite avaliar uma alternativa com base nos valores que já estão previstos para entrar.</p>\n        </div>\n        <div class=\"ar-timing__line\" data-ar-reveal=\"\" style=\"--reveal-delay: .12s;\" aria-label=\"Uma venda gera um recebível previsto para depois\">\n          <div class=\"ar-timing__point\">\n            <span class=\"ar-timing__dot\" aria-hidden=\"true\"></span>\n            <strong>Venda realizada</strong>\n            <span>A empresa conclui a venda</span>\n          </div>\n          <div class=\"ar-timing__gap\"><span>antecipação em análise</span></div>\n          <div class=\"ar-timing__point\">\n            <span class=\"ar-timing__dot\" aria-hidden=\"true\"></span>\n            <strong>Recebimento previsto</strong>\n            <span>O valor tem previsão de entrada futura</span>\n          </div>\n        </div>\n      </div>\n    </section>","items":[],"imageSource":"","theme":"white","layout":"left","spacing"