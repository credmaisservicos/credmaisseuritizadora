view-image\" src=\"/admin/preview/assets/securitizadora/assets/img/servicos/antecipacao-hero-wide.webp.webp\" sizes=\"(max-width: 1024px) 100vw, 440px\" alt=\"\" loading=\"eager\">\n    </a>\n    <a href=\"/servicos/boleto-garantido/\" class=\"mega__preview\" data-i=\"2\" tabindex=\"-1\" aria-hidden=\"true\" title=\"Conhecer Boleto Garantido\">\n      <img class=\"mega__preview-image\" src=\"/admin/preview/assets/securitizadora/assets/img/servicos/boleto-garantido-historia.webp.webp\" sizes=\"(max-width: 1024px) 100vw, 440px\" alt=\"\" loading=\"eager\">\n    </a>\n    <a href=\"/servicos/gestao-de-cobrancas/\" class=\"mega__preview\" data-i=\"3\" tabindex=\"-1\" aria-hidden=\"true\" title=\"Conhecer Gestão de cobranças\">\n      <img class=\"mega__preview-image\" src=\"/admin/preview/assets/securitizadora/assets/img/servicos/gestao-de-cobrancas-historia.webp.webp\" sizes=\"(max-width: 1024px) 100vw, 440px\" alt=\"\" loading=\"eager\">\n    </a></div>\n              </div>\n            </div>\n          </div>\n\n          <a href=\"/#como-funciona\" data-section=\"como-funciona\">Como funciona</a>\n          <a href=\"/contato/\" data-section=\"contato\">Contato</a>\n        </nav>\n\n        <div class=\"nav__actions\">\n          <a href=\"/contato/\" class=\"btn-navy\"><span>Fale conosco</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"></path></svg></a>\n          <button class=\"burger\" type=\"button\" aria-label=\"Abrir menu\" aria-expanded=\"false\" aria-controls=\"menu\">\n            <span></span><span></span>\n          </button>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  <div class=\"menu\" id=\"menu\" aria-hidden=\"true\">\n    <div class=\"menu__panel\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Menu\">\n      <nav class=\"menu__links\">\n        <a href=\"/#inicio\" data-section=\"inicio\"><small>01</small><span>Início</span></a>\n\n        <div class=\"menu__group is-open\">\n          <button class=\"menu__toggle\" type=\"button\" aria-expanded=\"true\" aria-controls=\"menu-servicos\">\n            <small>02</small><span>Serviços</span><i aria-hidden=\"true\"></i>\n          </button>\n          <div class=\"menu__sub\" id=\"menu-servicos\">\n            <div class=\"menu__sub-inner\">\n    <a href=\"/servicos/pix-parcelado/\" class=\"is-active\" aria-current=\"page\">Pix Parcelado</a>\n    <a href=\"/servicos/antecipacao-de-recebiveis/\">Antecipação de boletos e recebíveis</a>\n    <a href=\"/servicos/boleto-garantido/\">Boleto Garantido</a>\n    <a href=\"/servicos/gestao-de-cobrancas/\">Gestão de cobranças</a></div>\n          </div>\n        </div>\n\n        <a href=\"/#como-funciona\" data-section=\"como-funciona\"><small>03</small><span>Como funciona</span></a>\n        <a href=\"/contato/\" data-section=\"contato\"><small>04</small><span>Contato</span></a>\n      </nav>\n\n      <div class=\"menu__footer\">\n        <a href=\"/contato/\" class=\"btn-navy btn-navy--full\"><span>Fale conosco</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"></path></svg></a>\n        <div class=\"menu__contact\">\n          <a href=\"https://wa.me/5511940893852\" target=\"_blank\" rel=\"noopener\"><small>WhatsApp</small>(11) 94089-3852</a>\n          <a href=\"mailto:contato@sejacredmais.com\"><small>E-mail</small>contato@sejacredmais.com</a>\n        </div>\n      </div>\n    </div>\n  </div>\n  \n\n  <main>\n    <section class=\"pix-hero\" aria-labelledby=\"pix-title\" data-cm-hero=\"true\">\n      <img class=\"pix-hero__image\" src=\"/admin/preview/assets/securitizadora/assets/img/servicos/pix-parcelado-hero-final.webp.webp\" sizes=\"100vw\" width=\"1672\" height=\"941\" alt=\"Lojista conversa com cliente durante uma compra em uma boutique.\" fetchpriority=\"high\" loading=\"eager\">\n      <div class=\"pix-hero__shade\" aria-hidden=\"true\"></div>\n      <div class=\"pix-hero__copy\">\n        <p class=\"pix-hero__intro\">Uma nova possibilidade para suas vendas</p>\n        <h1 id=\"pix-title\" data-cm-hero-title=\"true\">Pix Parcelado<br><span>para suas <br class=\"pix-hero__mobile-break\">vendas.</span></h1>\n        <p class=\"pix-hero__description\" data-cm-hero-text=\"true\">Ofereça ao seu cliente a possibilidade de pagar a compra via Pix em parcelas, conforme as condições da operação.</p>\n        <a class=\"pix-action pix-action--white\" href=\"https://wa.me/5511940893852?text=Ol%C3%A1%2C%20quero%20conhecer%20o%20Pix%20Parcelado%20para%20minha%20empresa.\" target=\"_blank\" rel=\"noopener noreferrer\">\n          <span>Converse com a CredMais</span><span class=\"pix-action__arrow\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 12h14m-6-6 6 6-6 6\"></path></svg></span>\n        </a>\n      </div>\n      <a class=\"pix-hero__scroll\" href=\"#pix-bridge\"><span>Veja como funciona</span><span aria-hidden=\"true\">↓</span></a>\n    </section>\n\n    <section class=\"pix-bridge\" id=\"pix-bridge\" aria-labelledby=\"pix-bridge-title\" data-cm-section=\"original-0\">\n      <div class=\"pix-bridge__inner\">\n        <h2 class=\"pix-bridge__title\" id=\"pix-bridge-title\" data-cm-title=\"true\">Uma <span>nova opção</span><br>para o cliente decidir.</h2>\n        <p class=\"pix-bridge__description\" data-cm-text=\"true\">Sua empresa apresenta o Pix Parcelado e conversa com o cliente sobre as condições disponíveis para a compra.</p>\n      </div>\n    </section>\n\n    <!-- Composição imagem + conteúdo adaptada da Seção 197 do Code Eagle. -->\n    <section class=\"pix-venda\" id=\"pix-venda\" aria-labelledby=\"pix-venda-title\" data-cm-section=\"original-1\">\n      <img class=\"pix-venda__image\" src=\"/admin/preview/assets/securitizadora/assets/img/servicos/pix-parcelado-venda.webp.webp\" sizes=\"(max-width: 719px) calc(100vw - 48px), 60vw\" width=\"1672\" height=\"941\" alt=\"Cliente e comerciante conversam durante uma compra com Pix.\" loading=\"eager\" data-cm-image=\"true\">\n      <div class=\"pix-venda__shade\" aria-hidden=\"true\"></div>\n      <div class=\"pix-venda__copy\">\n        <p class=\"pix-kicker\">No momento da compra</p>\n        <h2 id=\"pix-venda-title\" data-cm-title=\"true\">No caixa, o cliente<br>escolhe como pagar.</h2>\n        <p data-cm-text=\"true\">O cliente escolhe o Pix Parcelado entre as opções disponíveis e avalia as condições antes de concluir a compra.</p>\n        <div class=\"pix-venda__roles\">\n          <p><strong>Para quem compra</strong><span>Uma alternativa de pagamento parcelado via Pix.</span></p>\n          <p><strong>Para sua empresa</strong><span>Uma opção a mais para apresentar no atendimento.</span></p>\n        </div>\n      </div>\n      <span class=\"pix-venda__caption\" aria-hidden=\"true\">Uma venda de cada vez. Um passo a mais para o negócio.</span>\n    </section>\n\n    <section class=\"pix-process\" aria-labelledby=\"pix-process-title\" data-cm-section=\"section-2\">\n      <div class=\"pix-process__inner\">\n        <div class=\"pix-process__heading\">\n          <p class=\"pix-kicker\">Para conhecer a solução</p>\n          <h2 id=\"pix-process-title\" data-cm-title=\"true\">Comece com uma conversa.</h2>\n          <p data-cm-text=\"true\">A equipe entende como sua empresa vende e explica as condições disponíveis para você avaliar.</p>\n        </div>\n        <div class=\"pix-process__timeline\">\n        <div class=\"pix-process__track\" aria-hidden=\"true\"><span class=\"pix-process__progress\" style=\"transform: scaleX(0);\"></span></div>\n        <ol class=\"pix-steps\">\n          <li class=\"pix-step is-active\">\n            <span class=\"pix-step__number\">01</span>\n            <div><h3>Conte sobre seu negócio</h3><p>Fale sobre sua empresa, seus clientes e como acontecem as vendas.</p></div>\n          </li>\n          <li class=\"pix-step\">\n            <span class=\"pix-step__number\">02</span>\n            <div><h3>Conheça as condições</h3><p>A CredMais apresenta os detalhes disponíveis para a sua operação.</p></div>\n          </li>\n          <li class=\"pix-step\">\n            <span class=\"pix-step__number\">03</span>\n            <div><h3>Avalie com clareza</h3><p>Com as informações em mãos, você decide se quer seguir adiante.</p></div>\n          </li>\n        </ol>\n        </div>\n        <a class=\"pix-text-link\" href=\"https://wa.me/5511940893852?text=Ol%C3%A1%2C%20quero%20conhecer%20as%20condi%C3%A7%C3%B5es%20do%20Pix%20Parcelado.\" target=\"_blank\" rel=\"noopener noreferrer\">Fale com a equipe <span aria-hidden=\"true\">↗</span></a>\n      </div>\n    </section>\n\n    <section class=\"pix-faq\" aria-labelledby=\"pix-faq-title\" data-cm-section=\"section-3\">\n      <div class=\"pix-faq__inner\">\n        <div class=\"pix-faq__heading\">\n          <p class=\"pix-kicker\">Dúvidas sobre o Pix Parcelado</p>\n          <h2 id=\"pix-faq-title\" data-cm-title=\"true\">O essencial, sem complicação.</h2>\n        </div>\n        <div class=\"pix-faq__items\">\n          <details class=\"pix-faq__item\"><summary>O que é Pix Parcelado?<span aria-hidden=\"true\"></span></summary><p data-cm-text=\"true\">É uma opção para o cliente pagar uma compra via Pix em parcelas, de acordo com as condições da operação.</p></details>\n          <details class=\"pix-faq__item\"><summary>Como minha empresa conhece as condições?<span aria-hidden=\"true\"></span></summary><p>Converse com a CredMais. A equipe explica os detalhes disponíveis para a sua empresa.</p></details>\n          <details class=\"pix-faq__item\"><summary>Existe um número fixo de parcelas?<span aria-hidden=\"true\"></span></summary><p>As condições dependem da operação. Fale com a equipe para conhecer as possibilidades para o seu negócio.</p></details>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"pix-contact\" aria-labelledby=\"pix-contact-title\" data-cm-section=\"original-4\">\n      <img class=\"pix-contact__image\" src=\"/admin/preview/assets/securitizadora/assets/img/servicos/pix-contact.webp.webp\" sizes=\"(max-width: 719px) calc(100vw - 48px), 60vw\" width=\"1672\" height=\"941\" alt=\"Empreendedora conversa com uma consultora sobre as vendas da boutique.\" loading=\"eager\" data-cm-image=\"true\">\n      <div class=\"pix-contact__shade\" aria-hidden=\"true\"></div>\n      <div class=\"pix-contact__copy\">\n        <p class=\"pix-kicker\">Sua empresa, sua próxima escolha</p>\n        <h2 id=\"pix-contact-title\" data-cm-title=\"true\">Vamos conversar<br>sobre suas vendas?</h2>\n        <p data-cm-text=\"true\">Fale com a CredMais para conhecer o Pix Parcelado e as condições para sua operação.</p>\n        <a class=\"pix-action pix-action--white\" href=\"https://wa.me/5511940893852?text=Ol%C3%A1%2C%20quero%20conversar%20sobre%20Pix%20Parcelado%20para%20minha%20empresa.\" target=\"_blank\" rel=\"noopener noreferrer\">\n          <span>Chame a CredMais no WhatsApp</span><span class=\"pix-action__arrow\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 12h14m-6-6 6 6-6 6\"></path></svg></span>\n        </a>\n      </div>\n    </section>\n  </main>\n\n  <div id=\"site-footer\">\n    <footer class=\"site-footer\" aria-label=\"Rodapé CredMais\">\n      <div class=\"container site-footer__inner\">\n        <div class=\"site-footer__brand\">\n          <a class=\"site-footer__logo\" href=\"/#inicio\" aria-label=\"CredMais — voltar ao início\">\n            <img src=\"/admin/preview/assets/securitizadora/assets/img/logo-branco.png.webp\" width=\"430\" height=\"143\" alt=\"CredMais Securitizadora\" loading=\"eager\">\n          </a>\n          <p>Soluções para sua empresa vender, receber e seguir em frente.</p>\n        </div>\n        <nav class=\"site-footer__nav\" aria-label=\"Links do rodapé\">\n          <h2>Navegue</h2>\n          <a href=\"/#inicio\">Início</a>\n          <a href=\"/#servicos\">Serviços</a>\n          <a href=\"/#como-funciona\">Como funciona</a>\n          <a h