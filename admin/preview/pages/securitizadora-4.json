preview-image\" src=\"/admin/preview/assets/securitizadora/assets/img/servicos/antecipacao-hero-wide.webp.webp\" sizes=\"(max-width: 1024px) 100vw, 440px\" alt=\"\" loading=\"eager\">\n    </a>\n    <a href=\"/servicos/boleto-garantido/\" class=\"mega__preview is-active\" data-i=\"2\" tabindex=\"-1\" aria-hidden=\"true\" title=\"Conhecer Boleto Garantido\">\n      <img class=\"mega__preview-image\" src=\"/admin/preview/assets/securitizadora/assets/img/servicos/boleto-garantido-historia.webp.webp\" sizes=\"(max-width: 1024px) 100vw, 440px\" alt=\"\" loading=\"eager\">\n    </a>\n    <a href=\"/servicos/gestao-de-cobrancas/\" class=\"mega__preview\" data-i=\"3\" tabindex=\"-1\" aria-hidden=\"true\" title=\"Conhecer Gestão de cobranças\">\n      <img class=\"mega__preview-image\" src=\"/admin/preview/assets/securitizadora/assets/img/servicos/gestao-de-cobrancas-historia.webp.webp\" sizes=\"(max-width: 1024px) 100vw, 440px\" alt=\"\" loading=\"eager\">\n    </a></div>\n              </div>\n            </div>\n          </div>\n\n          <a href=\"/#como-funciona\" data-section=\"como-funciona\">Como funciona</a>\n          <a href=\"/contato/\" data-section=\"contato\">Contato</a>\n        </nav>\n\n        <div class=\"nav__actions\">\n          <a href=\"/contato/\" class=\"btn-navy\"><span>Fale conosco</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"></path></svg></a>\n          <button class=\"burger\" type=\"button\" aria-label=\"Abrir menu\" aria-expanded=\"false\" aria-controls=\"menu\">\n            <span></span><span></span>\n          </button>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  <div class=\"menu\" id=\"menu\" aria-hidden=\"true\">\n    <div class=\"menu__panel\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Menu\">\n      <nav class=\"menu__links\">\n        <a href=\"/#inicio\" data-section=\"inicio\"><small>01</small><span>Início</span></a>\n\n        <div class=\"menu__group is-open\">\n          <button class=\"menu__toggle\" type=\"button\" aria-expanded=\"true\" aria-controls=\"menu-servicos\">\n            <small>02</small><span>Serviços</span><i aria-hidden=\"true\"></i>\n          </button>\n          <div class=\"menu__sub\" id=\"menu-servicos\">\n            <div class=\"menu__sub-inner\">\n    <a href=\"/servicos/pix-parcelado/\">Pix Parcelado</a>\n    <a href=\"/servicos/antecipacao-de-recebiveis/\">Antecipação de boletos e recebíveis</a>\n    <a href=\"/servicos/boleto-garantido/\" class=\"is-active\" aria-current=\"page\">Boleto Garantido</a>\n    <a href=\"/servicos/gestao-de-cobrancas/\">Gestão de cobranças</a></div>\n          </div>\n        </div>\n\n        <a href=\"/#como-funciona\" data-section=\"como-funciona\"><small>03</small><span>Como funciona</span></a>\n        <a href=\"/contato/\" data-section=\"contato\"><small>04</small><span>Contato</span></a>\n      </nav>\n\n      <div class=\"menu__footer\">\n        <a href=\"/contato/\" class=\"btn-navy btn-navy--full\"><span>Fale conosco</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"></path></svg></a>\n        <div class=\"menu__contact\">\n          <a href=\"https://wa.me/5511940893852\" target=\"_blank\" rel=\"noopener\"><small>WhatsApp</small>(11) 94089-3852</a>\n          <a href=\"mailto:contato@sejacredmais.com\"><small>E-mail</small>contato@sejacredmais.com</a>\n        </div>\n      </div>\n    </div>\n  </div>\n  \n\n  <main>\n    <section class=\"bg-hero\" aria-labelledby=\"bg-title\" data-cm-hero=\"true\">\n      <div class=\"bg-hero__copy\">\n        <p class=\"bg-kicker\">Mais segurança para vender</p>\n        <h1 id=\"bg-title\" data-cm-hero-title=\"true\">Boleto<br><span>Garantido</span></h1>\n        <p class=\"bg-hero__lead\" data-cm-hero-text=\"true\">Venda no boleto com garantia de recebimento, mesmo se o cliente não pagar.</p>\n        <a class=\"bg-button\" href=\"https://wa.me/5511940893852?text=Ol%C3%A1%2C%20quero%20conhecer%20o%20Boleto%20Garantido%20para%20minha%20empresa.\" target=\"_blank\" rel=\"noopener noreferrer\" data-cm-hero-button=\"true\">Converse com a CredMais <span aria-hidden=\"true\">↗</span></a>\n      </div>\n      <figure class=\"bg-hero__photo\"><img src=\"/admin/preview/assets/securitizadora/assets/img/servicos/boleto-garantido-historia.webp.webp\" sizes=\"(max-width: 719px) calc(100vw - 48px), 52vw\" width=\"1536\" height=\"1024\" alt=\"Empreendedor de uma pequena loja analisa um documento ao lado do balcão.\" fetchpriority=\"high\" loading=\"eager\"></figure>\n      <a class=\"bg-scroll\" href=\"#bg-context\">Entenda a solução <span aria-hidden=\"true\">↓</span></a>\n    </section>\n\n    <section class=\"bg-context\" id=\"bg-context\" aria-labelledby=\"bg-context-title\" data-cm-section=\"section-0\">\n      <div class=\"bg-context__inner\">\n        <div class=\"bg-context__heading\">\n          <p class=\"bg-kicker bg-kicker--gold\">Para vender com mais confiança</p>\n          <h2 id=\"bg-context-title\" data-cm-title=\"true\">O boleto pode fazer parte da venda. <span>A segurança também.</span></h2>\n        </div>\n        <p class=\"bg-context__text\" data-cm-text=\"true\">O Boleto Garantido é uma solução para empresas que vendem por boleto e buscam contar com garantia de recebimento, inclusive quando o cliente não paga. A CredMais conversa com você sobre a operação e suas condições.</p>\n      </div>\n    </section>\n\n    <section class=\"bg-visual\" aria-labelledby=\"bg-visual-title\" data-cm-section=\"section-1\">\n      <div class=\"bg-visual__image\"><img src=\"/admin/preview/assets/securitizadora/assets/img/servicos/boleto-garantido.webp.webp\" sizes=\"(max-width: 719px) 78vw, 40vw\" width=\"1122\" height=\"1402\" alt=\"Empreendedora segura um boleto enquanto elementos gráficos representam proteção e confirmação de recebimento.\" loading=\"eager\" data-cm-image=\"true\"></div>\n      <div class=\"bg-visual__copy\">\n        <p class=\"bg-kicker\">Uma alternativa para sua empresa</p>\n        <h2 id=\"bg-visual-title\" data-cm-title=\"true\">Mais clareza na hora de vender a prazo.</h2>\n        <p data-cm-text=\"true\">Quando o boleto faz sentido para o cliente, sua empresa pode avaliar uma solução que traz garantia de recebimento para a venda. A CredMais explica como o serviço se aplica ao seu negócio.</p>\n        <a class=\"bg-text-link\" href=\"https://wa.me/5511940893852?text=Quero%20conversar%20sobre%20Boleto%20Garantido.\" target=\"_blank\" rel=\"noopener noreferrer\">Fale sobre a sua operação <span aria-hidden=\"true\">→</span></a>\n      </div>\n    </section>\n\n    <section class=\"bg-steps\" aria-labelledby=\"bg-steps-title\" data-cm-section=\"section-2\">\n      <div class=\"bg-steps__inner\">\n        <header><p class=\"bg-kicker bg-kicker--gold\">Uma conversa antes de decidir</p><h2 id=\"bg-steps-title\" data-cm-title=\"true\">Entenda se o Boleto Garantido faz sentido para você.</h2></header>\n        <ol>\n          <li><span>01</span><div><h3>Conte como sua empresa vende</h3><p data-cm-text=\"true\">Apresente seu negócio e como o boleto entra na sua rotina comercial.</p></div></li>\n          <li><span>02</span><div><h3>Conheça os detalhes</h3><p>A equipe CredMais explica a solução e conversa sobre as condições da operação.</p></div></li>\n          <li><span>03</span><div><h3>Avalie com tranquilidade</h3><p>Com as informações, você pode analisar se quer seguir com a proposta.</p></div></li>\n        </ol>\n      </div>\n    </section>\n\n    <section class=\"bg-faq\" aria-labelledby=\"bg-faq-title\" data-cm-section=\"section-3\">\n      <div class=\"bg-faq__inner\">\n        <div><p class=\"bg-kicker\">Dúvidas sobre o serviço</p><h2 id=\"bg-faq-title\" data-cm-title=\"true\">Boleto Garantido, em poucas palavras.</h2></div>\n        <div class=\"bg-faq__items\">\n          <details><summary>O que é o Boleto Garantido?<span aria-hidden=\"true\"></span></summary><p data-cm-text=\"true\">É uma solução para a empresa vender no boleto com garantia de recebimento, mesmo se o cliente não pagar, conforme as condições da operação.</p></details>\n          <details><summary>Como sei se minha empresa pode usar?<span aria-hidden=\"true\"></span></summary><p>Converse com a CredMais e conte como sua empresa vende. A equipe explica os detalhes e as condições para avaliar.</p></details>\n          <details><summary>Como começo?<span aria-hidden=\"true\"></span></summary><p>Fale com a equipe pelo WhatsApp para apresentar seu negócio e conhecer os próximos passos.</p></details>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"bg-contact\" aria-labelledby=\"bg-contact-title\" data-cm-section=\"section-4\">\n      <div class=\"bg-contact__copy\"><p class=\"bg-kicker bg-kicker--light\">Sua próxima venda</p><h2 id=\"bg-contact-title\" data-cm-title=\"true\">Pode começar com uma conversa.</h2><p data-cm-text=\"true\">Conheça o Boleto Garantido e entenda as condições para a sua empresa.</p><a class=\"bg-button bg-button--white\" href=\"https://wa.me/5511940893852?text=Ol%C3%A1%2C%20quero%20conhecer%20o%20Boleto%20Garantido.\" target=\"_blank\" rel=\"noopener noreferrer\">Chame a CredMais <span aria-hidden=\"true\">↗</span></a></div>\n      <span class=\"bg-contact__word\" aria-hidden=\"true\">Boleto</span>\n    </section>\n  </main>\n\n  <div id=\"site-footer\">\n    <footer class=\"site-footer\" aria-label=\"Rodapé CredMais\">\n      <div class=\"container site-footer__inner\">\n        <div class=\"site-footer__brand\">\n          <a class=\"site-footer__logo\" href=\"/#inicio\" aria-label=\"CredMais — voltar ao início\">\n            <img src=\"/admin/preview/assets/securitizadora/assets/img/logo-branco.png.webp\" width=\"430\" height=\"143\" alt=\"CredMais Securitizadora\" loading=\"eager\">\n          </a>\n          <p>Soluções para sua empresa vender, receber e seguir em frente.</p>\n        </div>\n        <nav class=\"site-footer__nav\" aria-label=\"Links do rodapé\">\n          <h2>Navegue</h2>\n          <a href=\"/#inicio\">Início</a>\n          <a href=\"/#servicos\">Serviços</a>\n          <a href=\"/#como-funciona\">Como funciona</a>\n          <a href=\"/contato/\">Contato</a>\n        </nav>\n        <div class=\"site-footer__contact\">\n          <h2>Fale com a CredMais</h2>\n          <a href=\"https://wa.me/5511940893852\" target=\"_blank\" rel=\"noopener noreferrer\">WhatsApp <span>(11) 94089-3852</span></a>\n          <a href=\"mailto:contato@sejacredmais.com\">E-mail <span>contato@sejacredmais.com</span></a>\n          <a href=\"https://www.instagram.com/credmais.sa/\" target=\"_blank\" rel=\"noopener noreferrer\">Instagram <span>@credmais.sa</span></a>\n        </div>\n      </div>\n      <div class=\"container site-footer__bottom\">\n        <span>CredMais Securitizadora</span>\n        <a href=\"https://focussdev.art\" target=\"_blank\" rel=\"noopener noreferrer\">Desenvolvido por FocusDev <span aria-hidden=\"true\">↗</span></a>\n      </div>\n    </footer></div>\n  \n  \n  \n\n\n","bodyClass":"","sections":[{"id":"section-0","type":"original","title":"O boleto pode fazer parte da venda. A segurança também.","text":"O Boleto Garantido é uma solução para empresas que vendem por boleto e buscam contar com garantia de recebimento, inclusive quando o cliente não paga. A CredMais conversa com você sobre a operação e suas condições.","visible":true,"sourceHTML":"<section class=\"bg-context\" id=\"bg-context\" aria-labelledby=\"bg-context-title\" data-cm-section=\"section-0\">\n      <div class=\"bg-context__inner\">\n        <div class=\"bg-context__heading\">\n          <p class=\"bg-kicker bg-kicker--gold\">Para vender com mais confiança</p>\n          <h2 id=\"bg-context-title\" data-cm-title=\"true\">O boleto pode fazer parte da venda. <span>A segurança também.</span></h2>\n        </div>\n        <p class=\"bg-context__text\" data-cm-text=\"true\">O Boleto Garantido é uma solução p