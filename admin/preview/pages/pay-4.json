{"head":"\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"theme-color\" content=\"#071b45\">\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/brand/credmaispay-symbol.svg\">\n    <link rel=\"apple-touch-icon\" href=\"/brand/credmaispay-logo-transparent.png\">\n    <meta name=\"description\" content=\"Encontre respostas e canais de atendimento CredMaisPay.\">\n    <meta name=\"robots\" content=\"index, follow, max-image-preview:large\">\n    <link rel=\"canonical\" href=\"https://credmaispay.com/ajuda\">\n    <meta property=\"og:type\" content=\"website\">\n    <meta property=\"og:site_name\" content=\"CredMaisPay\">\n    <meta property=\"og:locale\" content=\"pt_BR\">\n    <meta property=\"og:title\" content=\"CredMaisPay — crédito para quem trabalha e empreende\">\n    <meta property=\"og:description\" content=\"Sem banco, sem gerente, sem burocracia. Mais crédito, mais oportunidades e mais vendas.\">\n    <meta property=\"og:url\" content=\"https://credmaispay.com/ajuda\">\n    <meta property=\"og:image\" content=\"https://credmaispay.com/images/campaign-conta-v2.png\">\n    <meta property=\"og:image:alt\" content=\"CredMaisPay: crédito, Pix e conta digital\">\n    <meta name=\"twitter:card\" content=\"summary_large_image\">\n    <meta name=\"twitter:title\" content=\"CredMaisPay — crédito para quem trabalha e empreende\">\n    <meta name=\"twitter:description\" content=\"Conta digital, Pix e microcrédito para sua rotina.\">\n    <meta name=\"twitter:image\" content=\"https://credmaispay.com/images/campaign-conta-v2.png\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n    <link href=\"https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&amp;family=Manrope:wght@500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n    <title>Ajuda e atendimento | CredMaisPa